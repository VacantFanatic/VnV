<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
      {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  --}}
      <div class="resources grid grid-4col">

        {{!-- "flex-group-center" is also defined in the _grid.scss file
        and it will add a small amount of padding, a border, and will
        center all of its child elements content and text. --}}
        <div class="resource flex-group-center">
          <label for="system.health.value" class="resource-label">Health</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.motes.value" class="resource-label">Motes</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.motes.value" value="{{system.motes.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.motes.max" value="{{system.motes.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.exertion.value" class="resource-label">Exertion</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.exertion.value" value="{{system.exertion.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.exertion.max" value="{{system.exertion.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.attributes.level.value" class="resource-label">Level</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.attributes.level.value" value="{{system.attributes.level.value}}" data-dtype="Number"/>
          </div>
        </div>

      </div>
      
      {{!-- Downed Section --}}
      <div class="downed-section flex-group-center">
        <label class="resource-label">Downed</label>
        <div class="downed-skulls flexrow flex-center">
          <i class="fas fa-skull downed-skull {{#if (gte system.downed.rounds 1)}}active{{/if}}" data-round="1" title="Round 1"></i>
          <i class="fas fa-skull downed-skull {{#if (gte system.downed.rounds 2)}}active{{/if}}" data-round="2" title="Round 2"></i>
          <i class="fas fa-skull downed-skull {{#if (gte system.downed.rounds 3)}}active{{/if}}" data-round="3" title="Round 3 (Death)"></i>
          <input type="hidden" name="system.downed.rounds" value="{{system.downed.rounds}}" data-dtype="Number"/>
        </div>
      </div>
      
      {{!-- Character Info Section --}}
      <div class="character-info grid grid-3col">
        <div class="flex-group-center">
          <label class="resource-label">Kin</label>
          <div class="drop-zone" data-drop-type="kin">
            {{#if system.kin}}
            <div class="chip">
              <span class="chip-text">{{system.kin}}</span>
              <a class="chip-delete" data-field="kin" title="Remove">
                <i class="fas fa-times"></i>
              </a>
            </div>
            {{else}}
            <div class="drop-zone-placeholder">Drop Kin here</div>
            {{/if}}
            <input type="hidden" name="system.kin" value="{{system.kin}}" data-dtype="String"/>
          </div>
        </div>
        <div class="flex-group-center">
          <label for="system.trait" class="resource-label">Trait</label>
          <input type="text" name="system.trait" value="{{system.trait}}" placeholder=""/>
        </div>
        <div class="flex-group-center">
          <label class="resource-label">Background</label>
          <div class="drop-zone" data-drop-type="background">
            {{#if system.background}}
            <div class="chip">
              <span class="chip-text">{{system.background}}</span>
              <a class="chip-delete" data-field="background" title="Remove">
                <i class="fas fa-times"></i>
              </a>
            </div>
            {{else}}
            <div class="drop-zone-placeholder">Drop Background here</div>
            {{/if}}
            <input type="hidden" name="system.background" value="{{system.background}}" data-dtype="String"/>
          </div>
        </div>
      </div>
      
      {{!-- Additional Info --}}
      <div class="character-info grid grid-2col">
        <div class="flex-group-center">
          <label for="system.refractoryPeriod" class="resource-label">Refractory Period (min)</label>
          <input type="text" name="system.refractoryPeriod" value="{{system.refractoryPeriod}}" data-dtype="Number"/>
        </div>
        <div class="flex-group-center">
          <label for="system.sexualPartners" class="resource-label">Number of Sexual Partners</label>
          <input type="text" name="system.sexualPartners" value="{{system.sexualPartners}}" data-dtype="Number"/>
        </div>
      </div>
      
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="features">Features</a>
    <a class="item" data-tab="items">Inventory</a>
    <a class="item" data-tab="spells">Spells</a>
    <a class="item" data-tab="status-vices">Status & Vices</a>
    <a class="item" data-tab="description">Description</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      <section class="grid grid-3col">
        <aside class="sidebar">

          {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
          use both the "grid" and "grid-Ncol" class where "N" can be any number
          from 1 to 12 and will create that number of columns.  --}}
          <div class="abilities flexcol">
            {{#each config.abilities as |label key|}}
            {{#if (lookup ../system.abilities key)}}
            {{#with (lookup ../system.abilities key) as |ability|}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left" data-roll="d20+@abilities.{{key}}.value" data-label="{{label}}">{{label}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number"/>
            </div>
            {{/with}}
            {{else}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left" data-roll="d20+@abilities.{{key}}.value" data-label="{{label}}">{{label}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="0" data-dtype="Number"/>
            </div>
            {{/if}}
            {{/each}}
          </div>
          
          {{!-- Combat Actions --}}
          <div class="combat-actions flexcol">
            <h3 class="resource-label">Combat Actions</h3>
            <div class="flexrow flex-group-center">
              <label>Combat Actions:</label>
              <span>{{system.actions.combatActions}} (Used: {{system.actions.usedCombatActions}})</span>
            </div>
            <div class="flexrow flex-group-center">
              <label>Tactical Actions:</label>
              <span>{{system.actions.tacticalActions}} (Used: {{system.actions.usedTacticalActions}})</span>
            </div>
          </div>
        </aside>

        {{!-- For the main classes list, span the right two columns --}}
        <section class="main grid-span-2">
          {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in module/helpers/templates.mjs --}}
          {{> "systems/VnV/templates/actor/parts/actor-classes.hbs"}}
        </section>

      </section>
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
      <div class="flex-group-center" style="margin-bottom: 10px;">
        <label for="system.currency.value" class="resource-label">Currency</label>
        <input type="text" name="system.currency.value" value="{{system.currency.value}}" data-dtype="Number"/>
      </div>
       {{> "systems/VnV/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Owned Spells Tab --}}
    <div class="tab spells" data-group="primary" data-tab="spells">
      {{> "systems/VnV/templates/actor/parts/actor-spells.hbs"}}
    </div>

    {{!-- Status & Vices Tab --}}
    <div class="tab status-vices flexcol" data-group="primary" data-tab="status-vices">
      {{> "systems/VnV/templates/actor/parts/actor-status-vices.hbs"}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

  </section>
</form>
