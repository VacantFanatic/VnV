<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='{{localize "DOCUMENT.Create" type='Class'}}'
        data-type='class'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='class'}}
      </a>
    </div>
  </li>
  {{#each classes as |classItem id|}}
    <li class='item flexrow class-header' data-item-id='{{classItem._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <img
            src='{{classItem.img}}'
            title='{{classItem.name}}'
            width='24'
            height='24'
          />
        </div>
        <h4>{{classItem.name}}</h4>
      </div>
      <div class='item-controls'>
        <a
          class='item-control item-create'
          title='{{localize "DOCUMENT.Create" type='Ability'}}'
          data-type='ability'
          data-parent-id='{{classItem._id}}'
        >
          <i class='fas fa-plus'></i>
          {{localize 'DOCUMENT.New' type='ability'}}
        </a>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Class'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='Class'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
    {{#if classItem.abilities}}
      {{#each classItem.abilities as |ability abilityId|}}
        <li class='item flexrow ability-item' data-item-id='{{ability._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <img
                src='{{ability.img}}'
                title='{{ability.name}}'
                width='20'
                height='20'
              />
            </div>
            <h5 style='margin-left: 20px;'>{{ability.name}}</h5>
          </div>
          <div class='item-controls'>
            <a
              class='item-control item-edit'
              title='{{localize "DOCUMENT.Update" type='Ability'}}'
            >
              <i class='fas fa-edit'></i>
            </a>
            <a
              class='item-control item-delete'
              title='{{localize "DOCUMENT.Delete" type='Ability'}}'
            >
              <i class='fas fa-trash'></i>
            </a>
          </div>
        </li>
      {{/each}}
    {{/if}}
  {{/each}}
</ol>
